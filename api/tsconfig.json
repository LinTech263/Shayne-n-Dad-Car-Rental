{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "./**/*.ts",
    "../src/data/**/*.ts",
    "../src/types/**/*.ts",
    "../src/utils/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../dist",
    "../src/**/*.test.ts"
  ]
}
