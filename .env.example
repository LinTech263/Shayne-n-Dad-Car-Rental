# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, sitemaps, and QR verification URLs.
APP_URL="https://shaynendadcarrental.co.zw"

# Port configuration (default: 3000)
PORT=3000

# Paynow Zimbabwe Gateway Configuration
# Obtain credentials from https://www.paynow.co.zw
PAYNOW_INTEGRATION_ID="12345"
PAYNOW_INTEGRATION_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
PAYNOW_SANDBOX_MODE="true"
PAYNOW_RESULT_URL="/api/payments/paynow-webhook"
PAYNOW_RETURN_URL="/book/confirmation"

# Meta WhatsApp Business Cloud API Configuration
# Meta Developer Portal: https://developers.facebook.com
WHATSAPP_API_TOKEN="EAAB..."
WHATSAPP_PHONE_NUMBER_ID="10987654321"
WHATSAPP_BUSINESS_ACCOUNT_ID="1234567890"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="shayne_dad_secure_token"

# Owner / Staff Portal Credentials & Session Encryption
ADMIN_SESSION_SECRET="super-secret-key-replace-in-production"
