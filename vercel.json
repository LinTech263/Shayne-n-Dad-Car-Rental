{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/cars", "destination": "/api/cars" },
    { "source": "/api/categories", "destination": "/api/categories" },
    { "source": "/api/services", "destination": "/api/services" },
    { "source": "/api/guides", "destination": "/api/guides" },
    { "source": "/api/faqs", "destination": "/api/faqs" },
    { "source": "/api/settings", "destination": "/api/settings" },
    { "source": "/api/enquiries", "destination": "/api/enquiries" },
    { "source": "/api/callback-request", "destination": "/api/callback-request" },
    { "source": "/((?!assets|vehicle-photos|api).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/vehicle-photos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
